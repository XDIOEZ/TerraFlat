<Project>
  <PropertyGroup>
    <RepoRoot>$(MSBuildThisFileDirectory)../../../</RepoRoot>
    <BaseIntermediateOutputPath>$(RepoRoot)Temp/Tests/ThermalRuntime/obj/</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath>$(BaseIntermediateOutputPath)</MSBuildProjectExtensionsPath>
    <BaseOutputPath>$(RepoRoot)Temp/Tests/ThermalRuntime/bin/</BaseOutputPath>
  </PropertyGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <!-- 直接编译生产公式和调用入口，替身只提供 Unity 与外部系统输入。 -->
    <Compile Include="$(RepoRoot)Assets/5_Scripts/5-3_GamePlay/World/Environment/ThermalRuntime.cs" />
    <Compile Include="$(RepoRoot)Assets/5_Scripts/5-3_GamePlay/World/Environment/TemperatureMgr.cs" />
    <Compile Include="$(RepoRoot)Assets/5_Scripts/5-3_GamePlay/World/Environment/WorldItemMatterRules.cs" />
    <Compile Include="$(RepoRoot)Assets/5_Scripts/5-3_GamePlay/Entities/Item/Definitions/ItemMatterReaction.cs" />
    <Compile Include="$(RepoRoot)Assets/5_Scripts/5-3_GamePlay/Entities/Item/Management/ItemMgr.Matter.cs" />
    <Compile Include="$(RepoRoot)Assets/5_Scripts/5-3_GamePlay/Entities/DroppedItems/DroppedItemRuntime.Matter.cs" />
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(MSBuildSDKsPath)/../Newtonsoft.Json.dll</HintPath>
    </Reference>
  </ItemGroup>
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
</Project>
