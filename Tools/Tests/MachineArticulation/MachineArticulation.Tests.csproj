<Project>
  <PropertyGroup>
    <RepoRoot>$(MSBuildThisFileDirectory)../../../</RepoRoot>
    <BaseIntermediateOutputPath>$(RepoRoot)Temp/Tests/MachineArticulation/obj/</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath>$(BaseIntermediateOutputPath)</MSBuildProjectExtensionsPath>
  </PropertyGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <OutputPath>$(RepoRoot)Temp/Tests/MachineArticulation/bin/</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="ProbeHost.cs" />
    <Compile Include="$(RepoRoot)Assets/5_Scripts/5-3_GamePlay/Presentation/Machines/MachineArticulatedKinematics.cs" />
    <Compile Include="$(RepoRoot)Assets/5_Scripts/5-3_GamePlay/Development/Testing/GameplayTestSystemProbe.MachineArticulation.cs" />
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(RepoRoot)Library/PackageCache/com.unity.nuget.newtonsoft-json@3.2.1/Runtime/Newtonsoft.Json.dll</HintPath>
    </Reference>
  </ItemGroup>
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
</Project>
