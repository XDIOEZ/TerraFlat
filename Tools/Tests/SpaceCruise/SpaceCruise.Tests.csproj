<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RepoRoot>$(MSBuildThisFileDirectory)../../../</RepoRoot>
  </PropertyGroup>
  <ItemGroup>
    <!-- 直接编译生产领域算法，不启动或暂停 Unity。 -->
    <Compile Include="$(RepoRoot)Assets/5_Scripts/5-3_GamePlay/World/Space/SpaceGameplaySettings.cs" />
    <Compile Include="$(RepoRoot)Assets/5_Scripts/5-3_GamePlay/World/Space/Universe/UniverseState.cs" />
    <Compile Include="$(RepoRoot)Assets/5_Scripts/5-3_GamePlay/World/Space/Ships/Domain/ShipState.cs" />
    <Compile Include="$(RepoRoot)Assets/5_Scripts/5-3_GamePlay/World/Space/Ships/Domain/ShipStructureService.cs" />
    <Compile Include="$(RepoRoot)Assets/5_Scripts/5-3_GamePlay/World/Space/Ships/Domain/ShipDockingService.cs" />
    <Compile Include="$(RepoRoot)Assets/5_Scripts/5-3_GamePlay/World/Space/Ships/Domain/ShipAssemblyCache.cs" />
    <Compile Include="$(RepoRoot)Assets/5_Scripts/5-3_GamePlay/World/Space/Ships/ShipCruiseGuidance.cs" />
    <Compile Include="$(RepoRoot)Assets/5_Scripts/5-3_GamePlay/World/Space/Ships/ShipOpticalGraph.cs" />
    <Compile Include="$(RepoRoot)Assets/5_Scripts/5-3_GamePlay/World/Space/Ships/ShipMassContributionPool.cs" />
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(MSBuildSDKsPath)/../Newtonsoft.Json.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
