<Project>
  <PropertyGroup>
    <RepoRoot>$(MSBuildThisFileDirectory)../../../</RepoRoot>
    <BaseIntermediateOutputPath>$(RepoRoot)Temp/Tests/MachineNetworks/obj/</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath>$(BaseIntermediateOutputPath)</MSBuildProjectExtensionsPath>
  </PropertyGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <OutputPath>$(RepoRoot)Temp/Tests/MachineNetworks/bin/$(Configuration)/</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <!-- 直接编译生产机械、电力和耦合调度算法，不启动或操作 Unity。 -->
    <Compile Include="Program.cs" />
    <Compile Include="TestDoubles.cs" />
    <Compile Include="ConveyorDoubles.cs" />
    <Compile Include="ConveyorTests.cs" />
    <Compile Include="ConveyorLoadTests.cs" />
    <Compile Include="$(RepoRoot)Assets/5_Scripts/5-3_GamePlay/World/Machines/MechanicalNetwork.cs" />
    <Compile Include="$(RepoRoot)Assets/5_Scripts/5-3_GamePlay/World/Machines/MechanicalNetworkGraph.Conveyors.cs" />
    <Compile Include="$(RepoRoot)Assets/5_Scripts/5-3_GamePlay/World/Machines/ConveyorPath.cs" />
    <Compile Include="$(RepoRoot)Assets/5_Scripts/5-3_GamePlay/World/Machines/ConveyorPresentation.cs" />
    <Compile Include="$(RepoRoot)Assets/5_Scripts/5-3_GamePlay/World/Machines/ElectricalNetwork.cs" />
    <Compile Include="$(RepoRoot)Assets/5_Scripts/5-3_GamePlay/World/Machines/MachineWorld.MechanicalSolver.cs" />
    <Compile Include="$(RepoRoot)Assets/5_Scripts/5-3_GamePlay/World/Machines/MachineWorld.Electrical.cs" />
    <Compile Include="$(RepoRoot)Assets/5_Scripts/5-3_GamePlay/Items/Crafting/CraftedWorkEfficiencyQuality.cs" />
    <Reference Include="MemoryPack.Core">
      <HintPath>$(RepoRoot)Assets/Packages/MemoryPack.Core.1.21.3/lib/netstandard2.1/MemoryPack.Core.dll</HintPath>
    </Reference>
  </ItemGroup>
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
</Project>
