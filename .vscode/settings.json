{
    "files.exclude": {
        "**/.DS_Store": true,
        "**/.git": true,
        "**/.gitmodules": true,
        "**/.vs": true,
        "**/.vsconfig": true,
        "**/*.3ds": true,
        "**/*.3DS": true,
        "**/*.asset": true,
        "**/*.booproj": true,
        "**/*.cubemap": true,
        "**/*.dll": true,
        "**/*.exe": true,
        "**/*.fbx": true,
        "**/*.FBX": true,
        "**/*.flare": true,
        "**/*.gif": true,
        "**/*.ico": true,
        "**/*.jpeg": true,
        "**/*.jpg": true,
        "**/*.lxo": true,
        "**/*.LXO": true,
        "**/*.ma": true,
        "**/*.MA": true,
        "**/*.mat": true,
        "**/*.meta": true,
        "**/*.mid": true,
        "**/*.midi": true,
        "**/*.obj": true,
        "**/*.OBJ": true,
        "**/*.pdf": true,
        "**/*.pidb": true,
        "**/*.prefab": false,
        "**/*.psd": true,
        "**/*.suo": true,
        "**/*.tga": true,
        "**/*.tif": true,
        "**/*.tiff": true,
        "**/*.unity": true,
        "**/*.unityproj": true,
        "**/*.user": true,
        "**/*.userprefs": true,
        "**/*.wav": true,
        "build/": true,
        "Build/": true,
        "library/": true,
        "Library/": true,
        "logs/": true,
        "Logs/": true,
        "obj/": true,
        "Obj/": true,
        "ProjectSettings/": true,
        "temp/": true,
        "Temp/": true,
        "UserSettings/": true
    },
    "dotnet.defaultSolution": "TerraFlat-master.sln",
    "dotnet.preferCSharpExtension": true,
    "workbench.editorAssociations": {
        "*.prefab": "unityPrefabBrowser.prefabEditor"
    },
    "outline-map.follow": "manual",
    "outline-map.expand": "expanded",
    "chat.permissions.default": "autoApprove",
    "chat.autopilot.advanced.enabled": true,
    "gcmp.commit.customInstructions": "生成详细的提交消息,简短但是全面的描述此次提交对系统的修改",
    "gcmp.commit.format": "custom"
}
