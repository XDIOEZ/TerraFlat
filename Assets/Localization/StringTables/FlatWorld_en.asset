  m_TableData:
  - m_Id: 27615045296885764
    m_Localized: "Copper Hammer"
    m_Metadata:
      m_Items: []
  - m_Id: 27615045296885765
    m_Localized: "A copper-headed metal hammer with a wooden handle. Use it at a metal anvil. Durability 100; each valid strike consumes 1 durability."
    m_Metadata:
      m_Items: []
  - m_Id: 27615045296885766
    m_Localized: "Iron Hammer"
    m_Metadata:
      m_Items: []
  - m_Id: 27615045296885767
    m_Localized: "A wrought-iron hammer for repeated forging at a metal anvil. Durability 200; each valid strike consumes 1 durability."
    m_Metadata:
      m_Items: []
  - m_Id: 27615045296885768
    m_Localized: "Steel Hammer"
    m_Metadata:
      m_Items: []
  - m_Id: 27615045296885769
    m_Localized: "A durable steel-headed hammer for forging at a metal anvil. Durability 400; each valid strike consumes 1 durability."
    m_Metadata:
      m_Items: []
  - m_Id: 27615045322402000
    m_Localized: "Crossbow"
    m_Metadata:
      m_Items: []
  - m_Id: 27615045322402001
    m_Localized: "A wooden crossbow using ordinary arrows, with the same damage, range and charge time as a recurve bow. Hold attack to fully load, then release without firing. Press and release attack again to shoot. Stamina drains only while loading, stopping at full charge. Releasing early cancels loading."
    m_Metadata:
      m_Items: []
  - m_Id: 27615045322402002
    m_Localized: "Crossbow"
    m_Metadata:
      m_Items: []
