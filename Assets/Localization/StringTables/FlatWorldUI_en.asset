  - m_Id: 10679430043176972
    m_Localized: Environment Info
    m_Metadata:
      m_Items: []
  - m_Id: 10679430043176973
    m_Localized: 'Show Temperature: Off'
    m_Metadata:
      m_Items: []
  - m_Id: 10679430043176974
    m_Localized: 'Show Pollution: Off'
    m_Metadata:
      m_Items: []
  - m_Id: 10679430043176975
    m_Localized: 'Show Monster Navigation: Off'
    m_Metadata:
      m_Items: []
  - m_Id: 10679430043176976
    m_Localized: "\u25A0  {temperature:0}\xB0C"
    m_Metadata:
      m_Items: []
  - m_Id: 10679430043176977
    m_Localized: "\u25A0  {load * 100f:0}%"
    m_Metadata:
      m_Items: []
  - m_Id: 10679430043176978
    m_Localized: "Temperature: blue is cold and red is hot, on a fixed -20 to 60\xB0C
      scale. Pollution: green is clean and red is heavily polluted; each cell shows
      the highest normalized load among registered pollution types, including MODs.
      Unloaded areas are transparent.\nMonster navigation: each reachable cell shows
      the next step toward the local player. A blue dot marks the player's target
      cell; a red cross marks unreachable cells. Obstacles and unloaded cells are
      not drawn. This reads the actual shared flow field; it does not mean every
      monster is chasing. Nothing appears until the target is ready.\nHigher opacity
      makes the surface clearer: 0% fully covered, 100% fully transparent."
    m_Metadata:
      m_Items: []
  - m_Id: 10679430043176979
    m_Localized: Opacity  {0:0}%
    m_Metadata:
      m_Items: []
