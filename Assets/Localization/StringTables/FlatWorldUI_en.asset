      m_Items: []
  - m_Id: 7219359759
    m_Localized: Easy
    m_Metadata:
      m_Items: []
  - m_Id: 7219359760
    m_Localized: "Keep all items on death \xB7 preserve the current game setup. The
      player drops no carried items on death."
    m_Metadata:
      m_Items: []
  - m_Id: 7219359761
    m_Localized: Hard
    m_Metadata:
      m_Items: []
  - m_Id: 7223554048
    m_Localized: "Drop all items on death \xB7 hostile creatures are more dangerous,
      survival drains are faster, recovery is slower, and all carried items are dropped
      on death."
