  - m_Id: 27608690188128263
    m_Localized: "\u653E\u7F6E\u540E\u953B\u9020\u91D1\u5C5E\u677F\u6216\u7F1D\u7EAB\u9488\uFF0C\u6BCF\u6B21\u953B\u6253\u63A8\u8FDB0.7\u5DE5\u4F5C\u79D2\u3002\u8010\u4E45500\uFF0C\u6BCF\u4EA7\u51FA\u4E00\u4EF6\u7269\u54C1\u6D88\u80171\u70B9\uFF1B\u8017\u5C3D\u540E\u635F\u574F\u5E76\u6389\u843D\u914D\u65B950%\u7684\u6750\u6599\u53CA\u5185\u90E8\u7269\u54C1\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 27608690188128264
    m_Localized: "\u4F7F\u7528\u540E\u653E\u7F6E\u5728\u5730\u4E0A\u624D\u80FD\u953B\u9020\u3002\u8010\u4E45500\uFF0C\u6BCF\u4EA7\u51FA\u4E00\u4EF6\u7269\u54C1\u6D88\u80171\u70B9\uFF1B\u8017\u5C3D\u540E\u635F\u574F\u5E76\u8FD4\u8FD85\u4E2A\u94DC\u952D\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 27608690188128265
    m_Localized: "\u94a8\u952d"
    m_Metadata:
      m_Items: []
  - m_Id: 27608690188128266
    m_Localized: "\u7531\u94a8\u77ff\u77f3\u57283422\u2103\u4ee5\u4e0a\u9ad8\u6e29\u51b6\u70bc\u5f97\u5230\u7684\u91d1\u5c5e\u952d\uff0c\u5bc6\u5ea6\u5927\u3001\u8010\u9ad8\u6e29\uff0c\u53ef\u4f5c\u4e3a\u9ad8\u7ea7\u6750\u6599\u50a8\u5b58\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 27608690188128267
    m_Localized: "\u94a8\u77ff\u77f3"
    m_Metadata:
      m_Items: []
  - m_Id: 27608690188128268
    m_Localized: "\u5730\u4e0b\u7a00\u6709\u7684\u542b\u94a8\u77ff\u77f3\u3002\u5c06\u7535\u78c1\u7089\u76ee\u6807\u6e29\u5ea6\u8bbe\u81f33422\u2103\u4ee5\u4e0a\uff0c\u6bcf2\u4efd\u53ef\u9ad8\u6e29\u51b6\u70bc\u4e3a1\u4efd\u94a8\u952d\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 27608690188128269
    m_Localized: "\u94a8\u77ff\u8109"
    m_Metadata:
      m_Items: []
  - m_Id: 27608690188128270
    m_Localized: "\u5730\u4e0b\u6d1e\u7a74\u4e2d\u7684\u7a00\u6709\u94a8\u77ff\u8109\uff0c\u6bd4\u94c1\u77ff\u575a\u786c\uff0c\u4f7f\u7528\u9550\u5f00\u91c7\u540e\u6389\u843d\u94a8\u77ff\u77f3\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 27615044965535744
    m_Localized: "\u94A2\u9489"
    m_Metadata:
      m_Items: []
  - m_Id: 27615045296885760
    m_Localized: "\u5DE5\u5177\u67DC-\u5EFA\u7B51"
    m_Metadata:
      m_Items: []
  - m_Id: 27615045296885761
    m_Localized: "\u5DE5\u5177\u67DC"
    m_Metadata:
      m_Items: []
  - m_Id: 27615045296885762
    m_Localized: "\u719F\u94C1\u9489"
    m_Metadata:
      m_Items: []
  - m_Id: 27615045296885763
    m_Localized: "\u91D1\u5C5E\u9489"
    m_Metadata:
      m_Items: []
  - m_Id: 27615045322402003
    m_Localized: "铁路"
    m_Metadata:
      m_Items: []
  - m_Id: 27615045322402004
    m_Localized: "铺设在地面的一格铁路，会自动连接成直线或弯道；支持矿车通行，不连接机械传动网络。"
    m_Metadata:
      m_Items: []
  - m_Id: 27615045322402005
    m_Localized: "铁路"
    m_Metadata:
      m_Items: []
  - m_Id: 27615045322402006
    m_Localized: "铺设在地面的一格铁路，会自动连接成直线或弯道；支持矿车通行，不连接机械传动网络。"
    m_Metadata:
      m_Items: []
  - m_Id: 27615045322402007
    m_Localized: "矿车"
    m_Metadata:
      m_Items: []
  - m_Id: 27615045322402008
    m_Localized: "可放在地面或铁路上，走向车体即可推动；地面阻力很大，铁轨上顺轨移动。每车一人，F 上下车；左侧两个引擎位、右侧18格货仓。水容器和燃料放入货仓，装好引擎后用 WASD 驾驶，地面只能缓慢挪动；附近矿车可连接共用动力。"
    m_Metadata:
      m_Items: []
  - m_Id: 27615045322402009
    m_Localized: "矿车"
    m_Metadata:
      m_Items: []
  - m_Id: 27615045322402010
    m_Localized: "可放在地面或铁路上，走向车体即可推动；地面阻力很大，铁轨上顺轨移动。每车一人，F 上下车；左侧两个引擎位、右侧18格货仓。水容器和燃料放入货仓，装好引擎后用 WASD 驾驶，地面只能缓慢挪动；附近矿车可连接共用动力。"
    m_Metadata:
      m_Items: []
  - m_Id: 27615045322402011
    m_Localized: "蒸汽机"
    m_Metadata:
      m_Items: []
  - m_Id: 27615045322402012
    m_Localized: "可拆装的蒸汽动力模块。拿在手上右键配置开关和输出档位；装入矿车左侧引擎槽，从列车货仓里的水容器与燃料取用资源，为整列矿车提供动力。"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
