        { "fact": "tutorial.stage", "operator": "Equal", "value": "CraftSparkMaker" }
      ],
      "lines": [
        "木棍和原木能做个钻木取火器，先把它合成出来。"
      ],
      "duration": 4.5,
      "cooldown": 45,
      "once": true,
      "completionFlag": "guide.survival.craft-spark-maker.shown",
      "enabled": true
    },
    {
