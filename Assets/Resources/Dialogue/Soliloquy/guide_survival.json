        { "fact": "tutorial.stage", "operator": "Equal", "value": "PlaceSparkMaker" }
      ],
      "lines": [
        "找块平整的地方，把钻木取火器安置下来。"
      ],
      "duration": 4.0,
      "cooldown": 45,
      "once": true,
      "completionFlag": "guide.survival.place-spark-maker.shown",
      "enabled": true
    },
    {
