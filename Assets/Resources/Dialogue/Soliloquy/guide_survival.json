        { "fact": "tutorial.enabled", "operator": "Equal", "value": "True" },
        { "fact": "tutorial.stage", "operator": "Equal", "value": "OpenInventory" }
      ],
      "lines": [
        "先看看身上的背包吧，得知道自己还缺些什么。"
      ],
      "duration": 4.2,
      "cooldown": 45,
      "once": true,
      "completionFlag": "guide.survival.open-inventory.shown",
      "enabled": true
    },
    {
