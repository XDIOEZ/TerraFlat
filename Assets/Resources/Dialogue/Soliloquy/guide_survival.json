        { "fact": "tutorial.enabled", "operator": "Equal", "value": "True" },
        { "fact": "tutorial.stage", "operator": "Equal", "value": "GatherSurvivalMaterials" }
      ],
      "lines": [
        "三根木棍、三块原木，再找一片树叶……这些应该够我把火生起来。"
      ],
      "duration": 5.2,
      "cooldown": 45,
      "once": true,
      "completionFlag": "guide.survival.gather-materials.shown",
      "enabled": true
    },
    {
