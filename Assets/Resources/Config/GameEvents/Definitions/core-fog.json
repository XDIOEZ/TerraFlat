{
  "$schema": "../game-events.schema.json",
  "schemaVersion": 1,
  "events": [
    {
      "id": "surface_daily_dense_fog",
      "displayName": "大雾",
      "description": "保留手动事件模板；自然雾量由区域湿度、温度和弱风连续计算。",
      "enabled": false,
      "priority": 30,
      "conflictGroup": "forced_weather",
      "oncePerWorld": false,
      "cooldownDays": 0,
      "durationDays": 0.25,
      "trigger": {
        "type": "day.schedule",
        "parameters": {
          "minimumDay": 2,
          "repeatEveryDays": 1,
          "timeOfDay": 0,
          "chance": 0.1
        }
      },
      "conditions": [
        {
          "type": "dimension.is",
          "parameters": { "allowedDimensionIds": ["surface"] }
        }
      ],
      "actions": [
        {
          "id": "force_fog",
          "type": "weather.override",
          "parameters": { "weather": "Fog", "intensity": 1.0 }
        }
      ]
    }
  ]
}
