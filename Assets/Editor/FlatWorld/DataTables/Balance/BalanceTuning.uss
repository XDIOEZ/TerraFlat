.balance-root {
    background-color: #0e131e;
    color: #e5edf8;
    flex-direction: column;
    flex-grow: 1;
    min-width: 780px;
}

.topbar {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    min-height: 104px;
    padding-left: 25px;
    padding-right: 25px;
    padding-top: 13px;
    padding-bottom: 12px;
    background-color: #151d2b;
    border-bottom-width: 1px;
    border-bottom-color: #2a3448;
}

.brand {
    flex-grow: 1;
}

.eyebrow {
    font-size: 10px;
    letter-spacing: 2px;
    color: #73a6d9;
    margin-bottom: 3px;
    -unity-font-style: bold;
}

.title {
    font-size: 23px;
    -unity-font-style: bold;
    color: #f4f8ff;
    margin-bottom: 3px;
}

.subtle {
    font-size: 11px;
    color: #8291a9;
    white-space: normal;
}

.toolbar-actions {
    flex-direction: column;
    align-items: flex-end;
    justify-content: center;
    min-width: 145px;
}

.workspace {
    flex-direction: row;
    flex-grow: 1;
    min-height: 300px;
}

.sidebar {
    flex-direction: column;
    flex-shrink: 0;
    width: 285px;
    background-color: #131a28;
    border-right-width: 1px;
    border-right-color: #273349;
    padding-top: 16px;
    padding-left: 12px;
    padding-right: 12px;
    padding-bottom: 8px;
}

.section-title {
    font-size: 14px;
    -unity-font-style: bold;
    color: #e8effc;
    margin-left: 6px;
    margin-bottom: 10px;
}

.search-label {
    color: #8ca9c7;
    font-size: 10px;
    margin-left: 6px;
    margin-bottom: 5px;
}

.search-input {
    margin-bottom: 12px;
    min-height: 29px;
}

.search-input .unity-text-field__input {
    background-color: #202b3e;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-color: #3b4c66;
    border-bottom-color: #3b4c66;
    border-left-color: #3b4c66;
    border-right-color: #3b4c66;
    color: #eaf3ff;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
    min-height: 27px;
}

.category-strip {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 9px;
}

.tab-button {
    height: 25px;
    padding-left: 10px;
    padding-right: 10px;
    margin-right: 4px;
    margin-bottom: 5px;
    background-color: #242f43;
    color: #9dacbf;
    border-top-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-right-width: 0;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
}

.tab-active {
    background-color: #2a5a94;
    color: #ffffff;
    -unity-font-style: bold;
}

.directory-count {
    color: #7b8ca3;
    font-size: 10px;
    margin-left: 7px;
    margin-top: 3px;
    margin-bottom: 7px;
}

.group-list {
    flex-grow: 1;
    background-color: #131a28;
    border-top-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-right-width: 0;
}

.group-list .unity-collection-view__item {
    background-color: #131a28;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
}

.group-list .unity-collection-view__item--selected {
    background-color: #283c5b;
    border-left-width: 3px;
    border-left-color: #6aacff;
}

.directory-row {
    flex-direction: column;
    justify-content: center;
    min-height: 61px;
    padding-left: 11px;
    padding-right: 8px;
}

.directory-name {
    color: #eaf3ff;
    font-size: 12px;
    -unity-font-style: bold;
    overflow: hidden;
    white-space: nowrap;
    -unity-text-overflow-position: end;
    text-overflow: ellipsis;
}

.directory-id {
    color: #9fb0c6;
    font-size: 10px;
    margin-top: 3px;
}

.directory-meta {
    color: #6b83a1;
    font-size: 10px;
    margin-top: 3px;
}

.content {
    flex-direction: column;
    flex-grow: 1;
    min-width: 350px;
    background-color: #0e131e;
}

.content-heading {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-left: 24px;
    padding-right: 24px;
    padding-top: 16px;
    padding-bottom: 13px;
}

.content-heading-text {
    flex-grow: 1;
    margin-right: 15px;
}

.detail-title {
    color: #f0f6ff;
    font-size: 19px;
    -unity-font-style: bold;
    margin-bottom: 5px;
}

.primary-button {
    min-width: 118px;
    height: 30px;
    background-color: #2874ce;
    color: #ffffff;
    border-top-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-right-width: 0;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
    -unity-font-style: bold;
}

.primary-button:hover {
    background-color: #3986dd;
}

.primary-button:disabled {
    background-color: #28364a;
    color: #8091a8;
}

.quiet-button {
    height: 27px;
    padding-left: 12px;
    padding-right: 12px;
    color: #adc7e6;
    background-color: #25354b;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-color: #334961;
    border-bottom-color: #334961;
    border-left-color: #334961;
    border-right-color: #334961;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
}

.quiet-button:hover {
    background-color: #304561;
}

.auto-toggle {
    color: #a1b4cb;
    font-size: 11px;
    margin-top: 7px;
}

.runtime-bar {
    margin-left: 24px;
    margin-right: 24px;
    margin-bottom: 8px;
    padding-left: 12px;
    padding-top: 9px;
    padding-bottom: 9px;
    background-color: #202b3d;
    border-left-width: 3px;
    border-left-color: #59718e;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

.runtime-playing {
    background-color: #16382e;
    border-left-color: #3fcc9d;
}

.runtime-label {
    color: #bdcfe5;
    font-size: 11px;
    white-space: normal;
}

.details-scroll {
    flex-grow: 1;
    padding-left: 24px;
    padding-right: 24px;
    padding-bottom: 18px;
}

.quick-actions {
    flex-direction: row;
    align-items: center;
    margin-bottom: 12px;
}

.muted-chip {
    color: #7e91ae;
    font-size: 10px;
    margin-left: 12px;
}

.group-heading {
    color: #88bafa;
    font-size: 12px;
    -unity-font-style: bold;
    margin-top: 7px;
    margin-bottom: 10px;
}

.tuning-card {
    flex-direction: column;
    background-color: #192233;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-color: #2b3b54;
    border-bottom-color: #2b3b54;
    border-left-color: #2b3b54;
    border-right-color: #2b3b54;
    border-top-left-radius: 9px;
    border-top-right-radius: 9px;
    border-bottom-left-radius: 9px;
    border-bottom-right-radius: 9px;
    padding-top: 13px;
    padding-bottom: 9px;
    padding-left: 15px;
    padding-right: 15px;
    margin-bottom: 11px;
}

.card-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 14px;
}

.card-identity {
    flex-grow: 1;
}

.card-title {
    color: #eaf2ff;
    font-size: 14px;
    -unity-font-style: bold;
    margin-bottom: 3px;
}

.field-path {
    color: #697f9b;
    font-size: 10px;
}

.count-chip {
    background-color: #273951;
    color: #8eacce;
    font-size: 10px;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 5px;
    padding-bottom: 5px;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
}

.tuning-controls {
    flex-direction: row;
    align-items: stretch;
    justify-content: space-between;
    min-height: 76px;
}

.down-button, .up-button {
    flex-grow: 1;
    min-width: 92px;
    min-height: 48px;
    margin-top: 7px;
    margin-bottom: 7px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    -unity-font-style: bold;
    font-size: 12px;
}

.down-button {
    background-color: #352a38;
    color: #eeb2ae;
    border-top-color: #674651;
    border-bottom-color: #674651;
    border-left-color: #674651;
    border-right-color: #674651;
}

.down-button:hover {
    background-color: #51313d;
}

.up-button {
    background-color: #193f3e;
    color: #8ce7c7;
    border-top-color: #2c6c64;
    border-bottom-color: #2c6c64;
    border-left-color: #2c6c64;
    border-right-color: #2c6c64;
}

.up-button:hover {
    background-color: #1d5752;
}

.value-box {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    flex-grow: 0;
    width: 116px;
    margin-left: 9px;
    margin-right: 9px;
}

.value-caption {
    font-size: 10px;
    color: #9cacbf;
    margin-bottom: 4px;
}

.primary-value {
    width: 100px;
    height: 31px;
}

.primary-value .unity-base-field__input {
    font-size: 17px;
    color: #ffffff;
    background-color: #273b55;
    -unity-font-style: bold;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
}

.settings-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    margin-top: 9px;
    margin-bottom: 6px;
}

.small-field {
    min-width: 115px;
    max-width: 145px;
    color: #a4b9d1;
}

.small-field .unity-base-field__label {
    min-width: 35px;
    width: 35px;
    color: #94a7bd;
}

.algorithm-hint {
    color: #718aa7;
    font-size: 10px;
    margin-left: 8px;
    margin-right: 8px;
}

.trend-chart {
    height: 52px;
    margin-top: 3px;
    margin-bottom: 5px;
    background-color: #151c2b;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
}

.history-foldout {
    color: #8caccb;
    font-size: 11px;
    margin-top: 7px;
}

.bounds-row {
    flex-direction: row;
    padding-top: 7px;
    padding-bottom: 7px;
}

.bounds-row .unity-base-field {
    flex-grow: 1;
}

.history-entry {
    font-size: 10px;
    color: #a7bcd2;
    padding-top: 3px;
    padding-bottom: 3px;
}

.typed-editor {
    color: #becce1;
    margin-bottom: 8px;
}

.status-footer {
    min-height: 33px;
    background-color: #151d2b;
    color: #8ea6c3;
    font-size: 10px;
    padding-left: 20px;
    padding-right: 15px;
    padding-top: 9px;
    border-top-width: 1px;
    border-top-color: #29364a;
}
