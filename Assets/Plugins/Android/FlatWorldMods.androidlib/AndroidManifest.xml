<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.flatworld.mods">
    <application>
        <provider android:name="com.flatworld.mods.FlatWorldModDocumentsProvider"
            android:authorities="${applicationId}.mods.documents"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>
    </application>
</manifest>
